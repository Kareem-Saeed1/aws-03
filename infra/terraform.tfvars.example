aws_region = "eu-west-1"
project_name = "scalable-webapp"
domain_name = "example.com" # Replace with your existing delegated public DNS zone.
hosted_zone_id = "Z_REPLACE_ME"
notification_email = "you@example.com"
instance_type = "t3.small"
db_instance_class = "db.t3.micro" # Confirm engine/class availability in your Region.
postgres_major_version = "16"
asg_max_size = 4
cpu_target = 50
monthly_budget_usd = 200 # Alert threshold, not a cost estimate or spending cap.
enable_db_bootstrap = true # Initial deployment only; turn false after database setup.
enable_step_scaling = false
deletion_protection = true
